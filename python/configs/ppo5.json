{
 "_comment": "Recommended setup. EntitySetExtractor (DeepSets over enemies, projectiles, spawns, materials and consumables), 30 BC epochs on demos/bot_melee60 (60 bot episodes from collect_demos.py), then gentle PPO with the bot as a teacher (weight 1 -> 0 over 3M steps) so PPO cannot undo the warm start early; 6M steps.",
 "spec": {
  "character": "character_well_rounded",
  "weapon": null,
  "danger": 0,
  "zone": 0,
  "start_wave": 1,
  "frame_skip": 4,
  "action_type": "discrete",
  "max_episode_steps": 20000,
  "game_options": {},
  "reward": {
   "damage_source": "hp",
   "damage_low_hp": 0.5,
   "kill": 0.003,
   "freedom_weight": 0,
   "wall_weight": 0,
   "shaping_gamma": 0.995
  },
  "encoder": {
   "free_rays": 16,
   "sectors": 8,
   "threat_features": true
  },
  "meta": {
   "type": "rule",
   "weapon_type": "melee",
   "tier_weight": 0.5,
   "stat_weights": {
    "max_hp": 0.43,
    "armor": 1.3,
    "dodge": 0.3,
    "hp_regeneration": 0.4,
    "lifesteal": 0.8,
    "melee_damage": 0.6,
    "percent_damage": 0.2,
    "attack_speed": 0.2,
    "crit_chance": 0.17,
    "speed": 0.23,
    "range": 0.02,
    "harvesting": 0.1,
    "luck": 0.04,
    "ranged_damage": 0,
    "elemental_damage": 0,
    "engineering": 0
   }
  }
 },
 "ppo": {
  "policy": "MultiInputPolicy",
  "n_steps": 1024,
  "batch_size": 512,
  "n_epochs": 4,
  "learning_rate": 7e-05,
  "lr_schedule": {
   "type": "linear",
   "start": 7e-05,
   "end": 2e-05,
   "horizon": 15000000
  },
  "gamma": 0.995,
  "gae_lambda": 0.95,
  "clip_range": 0.15,
  "ent_coef": 0.0,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": 0.015,
  "net_arch": {
   "pi": [
    256,
    256
   ],
   "vf": [
    256,
    256
   ]
  },
  "activation": "tanh",
  "extractor": {
   "type": "entity_set",
   "hidden": 64,
   "out": 64
  }
 },
 "train": {
  "n_envs": 6,
  "total_timesteps": 6000000,
  "seed": 0,
  "torch_threads": 4,
  "norm_reward": true,
  "checkpoint_every": 250000,
  "eval_every": 500000,
  "eval_episodes": 24,
  "eval_envs": 2,
  "eval_seed": 20000,
  "eval_stochastic": false,
  "bc": {
   "demos": "demos/bot_melee60",
   "epochs": 30,
   "batch_size": 1024,
   "learning_rate": 0.0003,
   "ent_coef": 0.003,
   "vf_coef": 0.5,
   "holdout": 0.1,
   "evaluate": true
  },
  "teacher": {
   "bot_params": {},
   "weight": 1.0,
   "decay_steps": 3000000,
   "learning_rate": 0.0001,
   "epochs": 2,
   "batch_size": 512
  }
 }
}
